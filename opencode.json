{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "lotm": {
      "type": "remote",
      "url": "https://lotm.marosconstruction.com/mcp",
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": ["npx", "@bitbonsai/mcpvault@latest", "C:/Users/david/Desktop/lotm project/lotm-vault"],
      "enabled": true
    }
  },
  "agent": {
    "lotm-content": {
      "mode": "primary",
      "model": "opencode/qwen3.6-plus"
    },
    "lotm-design": {
      "mode": "subagent",
      "model": "opencode/minimax-m3"
    }
  },
  "permission": {
    "lotm_list_card_library": "allow",
    "lotm_export_cards_zip": "allow",
    "lotm_save_card_batch": "allow",
    "lotm_save_card_image": "allow",
    "lotm_update_card": "allow",
    "lotm_move_cards": "allow",
    "lotm_delete_cards": "allow"
  }
}
