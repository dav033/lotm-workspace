# ---------- Build ----------
FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

ARG DATABASE_URL=postgresql://ci:ci@localhost:5432/ci
ENV DATABASE_URL=$DATABASE_URL

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY apps/game/package.json apps/game/package.json
COPY apps/card-studio/package.json apps/card-studio/package.json
COPY tools/obsidian-bridge/package.json tools/obsidian-bridge/package.json
RUN npm ci --workspace @lotm/game --include-workspace-root

COPY apps/game ./apps/game

RUN npx prisma generate --schema apps/game/prisma/schema.prisma \
  && npm run build -w @lotm/game

# ---------- Runtime ----------
FROM node:22-bookworm-slim AS runner
WORKDIR /app/apps/game
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/package.json /app/package-lock.json /app/
COPY --from=build /app/apps/game/package.json /app/apps/game/package.json
COPY --from=build /app/apps/game/.next /app/apps/game/.next
COPY --from=build /app/apps/game/public /app/apps/game/public
COPY --from=build /app/apps/game/prisma /app/apps/game/prisma
COPY --from=build /app/apps/game/prisma.config.ts /app/apps/game/prisma.config.ts
COPY --from=build /app/apps/game/next.config.ts /app/apps/game/next.config.ts
COPY --from=build /app/node_modules /app/node_modules

EXPOSE 3000

CMD ["sh", "-c", "npx prisma migrate deploy && npm run start -w @lotm/game"]
