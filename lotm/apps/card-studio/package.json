{
  "name": "@lotm/card-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "test": "tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "visual:record": "tsx test/visual/render-goldens.ts",
    "visual:check": "tsx test/visual/compare-goldens.ts",
    "mcp:stdio": "node --import tsx mcp/cards-stdio.ts",
    "mcp:http": "node --import tsx mcp/cards-http.ts",
    "cards:browser": "playwright install chromium"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.4.1",
    "ffmpeg-static": "^5.3.0",
    "next": "^15.5.4",
    "playwright": "^1.61.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/node": "^24.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
