# PostgreSQL/Supabase. Usa Session pooler (:5432) para servidor persistente
# o Transaction pooler (:6543) al desplegar Next.js en serverless.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"
# Conexión directa para migraciones, restauraciones y Prisma Studio.
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
DATABASE_POOL_MAX="10"
# Opcional: la suite usa un esquema aislado dentro de esta base.
TEST_DATABASE_URL=""

# Reservadas para futura integración con Supabase.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Autenticación administrativa desactivada por decisión del propietario.
ADMIN_PASSWORD="cambiar-esta-contrasena"
ADMIN_SESSION_SECRET="cambiar-por-un-secreto-largo"

# URL del estudio de cartas durante desarrollo.
NEXT_PUBLIC_CARDS_URL="http://localhost:3002/cartas"
