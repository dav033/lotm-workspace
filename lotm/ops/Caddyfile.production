api.marosconstruction.com {
  reverse_proxy api:3000
}

lotm.marosconstruction.com {
  route {
    @deploy path /deploy/github
    handle @deploy {
      reverse_proxy 172.18.0.1:9010
    }

    @cards_assets path /cartas/_next/*
    handle @cards_assets {
      uri strip_prefix /cartas
      reverse_proxy card-studio:3000
    }

    @cards_tiktok path /auth/tiktok /auth/tiktok/* /api/tiktok /api/tiktok/*
    handle @cards_tiktok {
      reverse_proxy card-studio:3000
    }

    @cards_web path /cartas /cartas/* /api/cards /api/cards/*
    handle @cards_web {
      reverse_proxy card-studio:3000
    }

    @cards_mcp path /mcp /mcp/* /downloads/*
    handle @cards_mcp {
      reverse_proxy cards-mcp:3101
    }

    handle {
      reverse_proxy lotm:3000
    }
  }
}

obsidian.marosconstruction.com {
  log {
    output stdout
    format json
  }
  reverse_proxy 172.18.0.1:27123
}
