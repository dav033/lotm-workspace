# ---------- Build ----------
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY apps/game/package.json apps/game/package.json
COPY apps/card-studio/package.json apps/card-studio/package.json
COPY tools/obsidian-bridge/package.json tools/obsidian-bridge/package.json
RUN npm ci --workspace @lotm/card-studio --include-workspace-root

COPY apps/card-studio ./apps/card-studio

RUN npm run build -w @lotm/card-studio

# ---------- Runtime ----------
FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV CARDS_PROJECT_ROOT=/app/apps/card-studio

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/apps/card-studio/package.json ./apps/card-studio/package.json
COPY --from=build /app/apps/card-studio/.next ./apps/card-studio/.next
COPY --from=build /app/apps/card-studio/public ./apps/card-studio/public
COPY --from=build /app/apps/card-studio/src ./apps/card-studio/src
COPY --from=build /app/apps/card-studio/mcp ./apps/card-studio/mcp
COPY --from=build /app/apps/card-studio/next.config.ts ./apps/card-studio/next.config.ts
COPY --from=build /app/node_modules ./node_modules

RUN npx playwright install --with-deps chromium

VOLUME /app/data
EXPOSE 3000 3101

CMD ["npm", "run", "start", "-w", "@lotm/card-studio"]
